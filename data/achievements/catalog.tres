[resource]
script = ExtResource("1_catalog")
achievements = Array[ExtResource("2_def")]([SubResource("ach_0"), SubResource("ach_1"), SubResource("ach_2"), SubResource("ach_3"), SubResource("ach_4"), SubResource("ach_5"), SubResource("ach_6"), SubResource("ach_7"), SubResource("ach_8"), SubResource("ach_9"), SubResource("ach_10"), SubResource("ach_11"), SubResource("ach_12"), SubResource("ach_13"), SubResource("ach_14"), SubResource("ach_15"), SubResource("ach_16"), SubResource("ach_17"), SubResource("ach_18"), SubResource("ach_19"), SubResource("ach_20"), SubResource("ach_21"), SubResource("ach_22"), SubResource("ach_23"), SubResource("ach_24")])
groups = Array[StringName]([&"driving", &"road", &"career"])
group_titles = PackedStringArray("DRIVING", "THE ROAD", "CAREER")
hairline_clearance_m = 0.25
mirror_achievements = true
mirror_boards = false
game_center_boards = Dictionary[StringName, String]({
&"daily": "westbound.board.daily",
&"distance": "westbound.board.distance",
&"journey": "westbound.board.journey"
})
play_games_boards = Dictionary[StringName, String]({
&"daily": "PLACEHOLDER_BOARD_DAILY",
&"distance": "PLACEHOLDER_BOARD_DISTANCE",
&"journey": "PLACEHOLDER_BOARD_JOURNEY"
})
