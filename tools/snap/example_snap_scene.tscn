[sub_resource type="Shader" id="Shader_unlit"]
code = "shader_type spatial;
render_mode unshaded;
uniform vec4 albedo : source_color = vec4(1.0);
void fragment() {
	// Cheap fake shading from the normal so the cube reads as 3D.
	ALBEDO = albedo.rgb * (0.55 + 0.45 * dot(NORMAL, normalize(vec3(0.3, 0.8, 0.5))));
}
"

