#!/usr/bin/env python3
"""Westbound linter: rendering budget + sim working rules (see docs/TOOLS.md).

  tools/lint                 # whole repo; prints file:line: RULE message, exit 1 on errors
  tools/lint src/traffic     # just these files/dirs
  tools/lint --strict        # warnings fail too
  tools/lint --self-test     # rules vs seeded fixtures in tools/lint_rules/fixtures
  tools/lint --rules         # list rule ids
"""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

from lint_rules.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
