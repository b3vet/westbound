# Local TLS proxy for westbound-server (N0 gate: wss:// end to end on one machine).
# Production TLS is Coolify's proxy (docs/MULTIPLAYER_PLAN.md MP-D1); this file is
# for local testing and non-Coolify hosts. Runbook: docs/SERVER.md.
#
#   WB_UPSTREAM   server address (default 127.0.0.1:8080)
#   WB_TLS_PORT   HTTPS port (default 8443)
#
# `tls internal` issues a certificate from Caddy's own local CA, so clients must
# trust that CA or skip verification (the dev tools do: Godot TLSOptions.client_unsafe(),
# Chromium --ignore-certificate-errors).
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	# Clients that send no SNI (Godot's TLSOptions.client_unsafe() does not) get the
	# localhost certificate. Without this, Caddy in Docker picks by the container IP
	# and fails the handshake.
	default_sni localhost
}

localhost:{$WB_TLS_PORT:8443}, 127.0.0.1:{$WB_TLS_PORT:8443} {
	tls internal

	@server path /api/* /ws /.well-known/*
	handle @server {
		# WebSocket upgrades pass through reverse_proxy unchanged.
		reverse_proxy {$WB_UPSTREAM:127.0.0.1:8080}
	}
	handle {
		respond "westbound local TLS proxy: /api/*, /ws and /.well-known/* go to the server" 404
	}
}
